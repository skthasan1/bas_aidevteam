{
  "organization": "acme",
  "owner": {
    "name": "Dana",
    "handles": [
      "dana-owner"
    ]
  },
  "roles": {
    "tech-lead": {
      "account": "acme-techlead-bot"
    },
    "ai-developer": {
      "account": "acme-dev-bot"
    },
    "qa-lead": {
      "account": "acme-qa-bot"
    },
    "security-lead": {
      "account": "acme-security-bot"
    },
    "researcher": {
      "account": "acme-research-bot"
    }
  },
  "bots": [
    "dependabot[bot]",
    "github-actions[bot]"
  ],
  "ai_comment_prefixes": [
    "Reviewed by",
    "QA report by",
    "Cleared by"
  ],
  "ai_accounts": [
    "acme-techlead-bot",
    "acme-dev-bot",
    "acme-qa-bot",
    "acme-research-bot",
    "sam-dev-bot-1",
    "sam-dev-bot-2",
    "sam-dev-bot-3",
    "acme-security-bot"
  ],
  "projects": {
    "notes": {
      "name": "Acme Notes",
      "default": "acme/notes-web",
      "repos": {
        "web": "acme/notes-web",
        "api": "acme/notes-api"
      },
      "owners": [
        "dana-owner"
      ],
      "testing": "active",
      "watch": "review",
      "lead": "acme-techlead-bot",
      "merge": "lead-on-owner-word",
      "covers": {
        "review": "role:tech-lead",
        "test": "role:qa-lead",
        "security": "role:security-lead",
        "decision": "person:dana-owner"
      }
    },
    "tasks": {
      "name": "Acme Tasks",
      "default": "acme/tasks",
      "repos": {
        "tasks": "acme/tasks"
      },
      "owners": [
        "dana-owner"
      ],
      "testing": "later",
      "watch": "off",
      "lead": "acme-techlead-bot",
      "merge": "owner-only",
      "members": [
        "sam-dev"
      ],
      "covers": {
        "review": "role:tech-lead",
        "test": "person:dana-owner",
        "security": "role:security-lead",
        "decision": "person:dana-owner"
      }
    }
  },
  "mode": "team",
  "people": {
    "dana-owner": {
      "roles": [
        "tech-lead",
        "qa-lead",
        "researcher",
        {
          "name": "ai-developer",
          "account": "acme-dev-bot"
        },
        {
          "name": "security-lead",
          "account": "acme-security-bot"
        }
      ]
    },
    "sam-dev": {
      "roles": [
        {
          "name": "ai-developer",
          "account": "sam-dev-bot-1"
        },
        {
          "name": "ai-developer",
          "account": "sam-dev-bot-2"
        },
        {
          "name": "ai-developer",
          "account": "sam-dev-bot-3"
        }
      ]
    }
  }
}
