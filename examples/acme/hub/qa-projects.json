{
  "organization": "acme",
  "owner": {
    "name": "Dana",
    "handles": [
      "dana-owner"
    ]
  },
  "roles": [
    {
      "name": "tech-lead",
      "account": "acme-techlead-bot",
      "headless": "read-only"
    },
    {
      "name": "ai-developer",
      "account": "acme-dev-bot",
      "headless": "write-branch"
    },
    {
      "name": "qa-lead",
      "account": "acme-qa-bot"
    },
    {
      "name": "security-lead",
      "account": "acme-security-bot"
    },
    {
      "name": "researcher",
      "account": "acme-research-bot"
    }
  ],
  "projects": {
    "notes": {
      "name": "Acme Notes",
      "default": "acme/notes-web",
      "repos": {
        "web": "acme/notes-web",
        "api": "acme/notes-api"
      },
      "owners": [
        "dana-owner"
      ],
      "testing": "active",
      "watch": "review",
      "lead": "acme-techlead-bot",
      "merge": "lead-on-owner-word",
      "covers": {
        "review": "role:tech-lead",
        "test": "role:qa-lead",
        "security": "role:security-lead",
        "decision": "person:dana-owner"
      },
      "decision_areas": {},
      "members": []
    },
    "tasks": {
      "name": "Acme Tasks",
      "default": "acme/tasks",
      "repos": {
        "tasks": "acme/tasks"
      },
      "owners": [
        "dana-owner"
      ],
      "testing": "later",
      "watch": "off",
      "lead": "acme-techlead-bot",
      "merge": "owner-only",
      "members": [
        "sam-dev"
      ],
      "covers": {
        "review": "role:tech-lead",
        "test": "person:dana-owner",
        "security": "role:security-lead",
        "decision": "person:dana-owner"
      },
      "decision_areas": {}
    }
  },
  "mode": "team",
  "people": {
    "dana-owner": {
      "roles": [
        {
          "name": "tech-lead",
          "account": "acme-techlead-bot",
          "headless": "read-only",
          "surface": "editor"
        },
        {
          "name": "qa-lead",
          "account": "acme-qa-bot",
          "surface": "terminal"
        },
        {
          "name": "researcher",
          "account": "acme-research-bot",
          "surface": "terminal"
        },
        {
          "name": "ai-developer",
          "account": "acme-dev-bot",
          "headless": "write-branch",
          "surface": "editor"
        },
        {
          "name": "security-lead",
          "account": "acme-security-bot",
          "headless": "read-only",
          "surface": "background"
        }
      ]
    },
    "sam-dev": {
      "roles": [
        {
          "name": "ai-developer",
          "account": "sam-dev-bot-1",
          "surface": "editor"
        },
        {
          "name": "ai-developer",
          "account": "sam-dev-bot-2",
          "surface": "editor"
        },
        {
          "name": "ai-developer",
          "account": "sam-dev-bot-3",
          "surface": "editor"
        }
      ]
    }
  },
  "runner": {
    "command": "<agent-a-command>",
    "args": [
      "<non-interactive flag from your agent's documentation>"
    ],
    "prompt_via": "arg",
    "timeout_minutes": 30
  },
  "bots": [
    "dependabot[bot]",
    "github-actions[bot]"
  ],
  "ai_comment_prefixes": [
    "Reviewed by",
    "QA report by",
    "Cleared by"
  ],
  "ai_accounts": [
    "acme-techlead-bot",
    "acme-dev-bot",
    "acme-qa-bot",
    "acme-research-bot",
    "sam-dev-bot-1",
    "sam-dev-bot-2",
    "sam-dev-bot-3",
    "acme-security-bot"
  ]
}
